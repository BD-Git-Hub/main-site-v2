---
import "../styles/global.css";

const {
  title = "Bovin De Souza | Digital studio portfolio",
  description = "Brighton-based developer creating cinematic web experiences, automation tools, 3D interactions, and digital products.",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL("/og-image.svg", Astro.site);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Bovin De Souza",
  url: Astro.site?.toString(),
  email: "mailto:bovindesouza@gmail.com",
  jobTitle: "Developer",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Brighton",
    addressCountry: "GB",
  },
  knowsAbout: [
    "Web development",
    "Automation tools",
    "AI workflows",
    "3D interactions",
    "Commerce systems",
  ],
  sameAs: ["https://www.linkedin.com/in/bovin-de-souza-10462b11b/"],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06070d" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="Bovin De Souza cinematic digital studio portfolio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
