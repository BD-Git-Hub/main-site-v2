---
import BaseLayout from "../layouts/BaseLayout.astro";
import TechIcon from "../components/TechIcon.astro";

const featuredProjects = [
  {
    number: "01",
    title: "Cut My",
    category: "E-commerce",
    href: "https://www.cutmy.co.uk/",
    image: "/media/images/projectimg/cutMy.webp",
    imageAlt: "Cut My ecommerce website preview",
    description:
      "A cut-to-size DIY materials store that makes ordering custom plastic and wood simpler across a Magento and AWS stack.",
    tags: ["Magento", "AWS", "Microservices"],
  },
  {
    number: "02",
    title: "FilmFlick",
    category: "Movie discovery",
    href: "https://movies-project-vue-8ql2.vercel.app/home",
    image: "/media/images/projectimg/moviesSiteImg.webp",
    imageAlt: "FilmFlick movie discovery website preview",
    description:
      "A Vue movie discovery platform for searching films, filtering by genre, viewing ratings, watching trailers, and exploring live TMDB data.",
    tags: ["Vue", "TMDB API", "Responsive UI"],
  },
  {
    number: "03",
    title: "Automate Me",
    category: "Mobile app concept",
    image: "/media/images/projectimg/automate-me-placeholder.svg",
    imageAlt: "Automate Me mobile automation concept preview",
    description:
      "An in-progress mobile application concept focused on reducing repetitive tasks and turning everyday automation ideas into a usable product flow.",
    tags: ["UI/UX", "Mobile App", "Product Design"],
  },
  {
    number: "04",
    title: "Cut To Size",
    category: "Trade website",
    href: "https://cuttosize.co.uk/",
    image: "/media/images/projectimg/Cuttosize.webp",
    imageAlt: "Cut To Size website preview",
    description:
      "A conversion-focused web presence for a precision wood cutting supplier, built around clear quote and price-list journeys.",
    tags: ["AWS", "Conversion", "Trade"],
  },
  {
    number: "05",
    title: "Echelon Estates",
    category: "Property listings",
    href: "https://site4.bovin-desouza-wordpress.com/",
    image: "/media/images/projectimg/EchelonEstates.webp",
    imageAlt: "Echelon Estates website preview",
    description:
      "A polished property platform with reusable listing templates, structured imports, and search-ready content patterns.",
    tags: ["WordPress", "ACF", "SEO"],
  },
  {
    number: "06",
    title: "Basket & Co",
    category: "WooCommerce",
    href: "https://site3.bovin-desouza-wordpress.com/",
    image: "/media/images/projectimg/basket&Co.webp",
    imageAlt: "Basket & Co ecommerce website preview",
    description:
      "A WooCommerce storefront with category browsing, cart, checkout, test payments, analytics visibility, and merchandising content.",
    tags: ["WooCommerce", "Elementor", "Analytics"],
  },
  {
    number: "07",
    title: "Macros Calculator",
    category: "Nutrition tracker",
    href: "https://macro-calculator-website.vercel.app/",
    image: "/media/images/projectimg/macrosCalculatorSiteImg.webp",
    imageAlt: "Macros Calculator website preview",
    description:
      "A React tracker for logging daily carbs, protein, and fats with account access, saved entries, and automatic logout.",
    tags: ["React", "Firebase", "Auth"],
  },
  {
    number: "08",
    title: "Suits and Styles",
    category: "Tailoring brand",
    href: "https://site1.bovin-desouza-wordpress.com/",
    image: "/media/images/projectimg/SuitsAndStyles.webp",
    imageAlt: "Suits and Styles website preview",
    description:
      "A business website for a tailoring brand, focused on service discovery, brand story, and simple enquiry paths.",
    tags: ["WordPress", "Elementor", "Enquiries"],
  },
  {
    number: "09",
    title: "Taste Travel",
    category: "Travel content",
    href: "https://site2.bovin-desouza-wordpress.com/",
    image: "/media/images/projectimg/tasteTravel.webp",
    imageAlt: "Taste Travel website preview",
    description:
      "A destination-led travel blog with structured navigation, location pages, newsletter signup, and enquiry routes.",
    tags: ["WordPress", "Content", "Newsletter"],
  },
  {
    number: "10",
    title: "Bovin De Souza",
    category: "Original portfolio",
    href: "https://bovin-desouza.vercel.app/",
    image: "/media/images/projectimg/bovin-desouza-vercel.webp",
    imageAlt: "Original Bovin De Souza portfolio website preview",
    description:
      "The original personal portfolio, combining biography, skills, project archive, and contact content into a single-page experience.",
    tags: ["HTML5", "CSS3", "JavaScript"],
  },
];

const technologyGroups = [
  {
    title: "Frontend",
    tools: ["HTML5", "CSS3", "JavaScript", "React", "Vue"],
  },
  {
    title: "Backend",
    tools: ["PHP", "Node.js", "SQL", "REST", "Firebase"],
  },
  {
    title: "CMS & Tools",
    tools: ["WordPress", "Elementor", "Sass", "Git", "AWS"],
  },
  {
    title: "Other",
    tools: ["Photoshop", "Maya", "ZBrush", "Unity", "After Effects"],
  },
];

const beyondCards = [
  {
    title: "Gym",
    subtitle: "Training and fitness",
    image: "/media/images/beyond/gym-environment.svg",
  },
  {
    title: "Exploration",
    subtitle: "Exploring new places",
    image: "/media/images/me/me3.webp",
  },
  {
    title: "Diving",
    subtitle: "Underwater exploration",
    image: "/media/images/beyond/scuba-diving.webp",
  },
];

const systemNodes = [
  { title: "React UI", text: "Frontend", className: "system-node--ui", icon: "react" },
  { title: "API", text: "Node.js / Express", className: "system-node--api", icon: "api" },
  { title: "Data", text: "PostgreSQL / MongoDB", className: "system-node--data", icon: "data" },
  { title: "People", text: "Users & Community", className: "system-node--people", icon: "people" },
];

const systemEvents = [
  { label: "Build", text: "Deployed new version", time: "2m ago", tone: "lime" },
  { label: "API", text: "Data sync completed", time: "12m ago", tone: "cyan" },
  { label: "Frontend", text: "Static assets optimised", time: "28m ago", tone: "lime" },
  { label: "Users", text: "New user signed up", time: "1h ago", tone: "lime" },
];
---

<BaseLayout>
  <main class="redesign-shell">
    <div class="light-field" aria-hidden="true">
      <canvas id="fiber-field" class="fiber-canvas"></canvas>
    </div>

    <header class="redesign-nav" aria-label="Primary navigation">
      <a class="redesign-brand" href="#top" aria-label="Bovin De Souza home">
        <span class="brand-mark" aria-hidden="true">◆</span>
        <span>Bovin De Souza</span>
      </a>
      <nav class="redesign-nav__links">
        <a href="#about">About</a>
        <a href="#skills">Skills</a>
        <a href="#portfolio">Portfolio</a>
        <a href="#beyond">Beyond the desk</a>
        <a href="#contact">Contact</a>
      </nav>
      <a class="nav-cta" href="mailto:bovindesouza@gmail.com">Let's talk &rarr;</a>
    </header>

    <section class="redesign-hero" id="top" aria-labelledby="hero-title">
      <div class="hero-copy" data-reveal>
        <p class="status-badge">Web developer / Digital creator</p>
        <h1 id="hero-title">
          I build digital experiences that <em>connect people.</em>
        </h1>
        <p>
          Full-stack web developer focused on creating modern, high-performing
          websites and web applications. I turn ideas into digital experiences
          that are practical, user-focused and built to grow.
        </p>
        <div class="hero-actions">
          <a class="button-lime" href="#portfolio">View my work &rarr;</a>
          <a class="button-ghost" href="/BovinDeSouzaCV.pdf" download>Download CV &darr;</a>
        </div>
        <p class="status-line"><span></span> Based in Brighton · Open to opportunities</p>
      </div>

      <div class="workflow-dashboard system-board" data-reveal style="--reveal-delay: 160ms">
        <div class="workflow-dashboard__top">
          <span class="system-board__live"><i></i>System <em>Online</em></span>
          <span class="system-board__dots" aria-hidden="true"><i></i><i></i><i></i></span>
        </div>
        <div class="system-board__map">
          <svg class="system-board__lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="system-flow" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#39d5e8" />
                <stop offset="0.55" stop-color="#7dff9a" />
                <stop offset="1" stop-color="#c4ff4d" />
              </linearGradient>
            </defs>
            <path d="M22 44 C34 28 42 14 50 18 C60 22 64 30 70 40" />
            <path d="M22 54 C34 72 42 84 48 78 C60 70 65 56 72 46" />
            <path d="M50 28 C44 42 44 58 48 74" />
          </svg>
          {systemNodes.map((node) => (
            <div class={`system-node ${node.className}`}>
              <span class="system-node__icon" aria-hidden="true">
                {node.icon === "react" && (
                  <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="2.1" />
                    <ellipse cx="12" cy="12" rx="9" ry="3.5" fill="none" stroke="currentColor" stroke-width="1.4" />
                    <ellipse cx="12" cy="12" rx="9" ry="3.5" fill="none" stroke="currentColor" stroke-width="1.4" transform="rotate(60 12 12)" />
                    <ellipse cx="12" cy="12" rx="9" ry="3.5" fill="none" stroke="currentColor" stroke-width="1.4" transform="rotate(120 12 12)" />
                  </svg>
                )}
                {node.icon === "api" && (
                  <svg viewBox="0 0 24 24">
                    <path d="M9 7 L4.5 12 L9 17" />
                    <path d="M15 7 L19.5 12 L15 17" />
                  </svg>
                )}
                {node.icon === "data" && (
                  <svg viewBox="0 0 24 24">
                    <ellipse cx="12" cy="7" rx="6.2" ry="2.5" />
                    <path d="M5.8 7 v10.2 c0 1.4 2.8 2.5 6.2 2.5 s6.2-1.1 6.2-2.5 V7" />
                    <path d="M5.8 12.2 c0 1.4 2.8 2.5 6.2 2.5 s6.2-1.1 6.2-2.5" />
                  </svg>
                )}
                {node.icon === "people" && (
                  <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="8" r="2.7" />
                    <path d="M6.4 18.5 c.8-3.2 2.8-4.8 5.6-4.8 s4.8 1.6 5.6 4.8" />
                  </svg>
                )}
              </span>
              <span class="system-node__copy">
                <strong>{node.title}</strong>
                <span>{node.text}</span>
              </span>
              <i class="system-node__pip" aria-hidden="true"></i>
            </div>
          ))}
        </div>
        <ul class="system-board__log">
          {systemEvents.map((event) => (
            <li>
              <i class={`system-board__dot system-board__dot--${event.tone}`} aria-hidden="true"></i>
              <span>{event.label}</span>
              <p>{event.text}</p>
              <time>{event.time}</time>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="redesign-section portfolio-section" id="portfolio" aria-labelledby="portfolio-title">
      <div class="section-kicker">01. Selected work</div>
      <div class="section-heading-row">
        <h2 id="portfolio-title">A few things I've brought <em>to life.</em></h2>
      </div>
      <div class="project-grid">
        {featuredProjects.map((project) => (
          <article class="feature-card" data-reveal>
            <div class="feature-card__meta">
              <span>{project.number}</span>
              <p>{project.title} — {project.category}</p>
              {project.href && <a href={project.href} target="_blank" rel="noreferrer" aria-label={`Open ${project.title}`}>↗</a>}
            </div>
            <a class="feature-card__image" href={project.href ?? "#contact"} target={project.href ? "_blank" : undefined} rel={project.href ? "noreferrer" : undefined}>
              <img src={project.image} alt={project.imageAlt} loading="lazy" />
            </a>
            <div class="feature-card__body">
              <p>{project.description}</p>
              <div>
                {project.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="redesign-section skills-section" id="skills" aria-labelledby="skills-title">
      <div class="section-kicker">02. The toolkit</div>
      <div class="skills-layout">
        <div class="skills-copy" data-reveal>
          <h2 id="skills-title">Technologies <em>I work with.</em></h2>
          <p>
            A combination of front-end, back-end and creative skills to build
            complete digital solutions.
          </p>
        </div>
        <div class="tech-grid">
          {technologyGroups.map((group, index) => (
            <article class="tech-card" data-reveal style={`--reveal-delay: ${index * 80}ms`}>
              <h3><span></span>{group.title}</h3>
              <div class="tech-card__tools">
                {group.tools.map((tool) => (
                  <span class="tech-pill">
                    <TechIcon name={tool} />
                    <span>{tool}</span>
                  </span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="redesign-section beyond-section" id="beyond" aria-labelledby="beyond-title">
      <div class="section-kicker">03. Off the clock</div>
      <div class="beyond-layout">
        <div class="beyond-copy" data-reveal>
          <h2 id="beyond-title">Beyond <em>the desk.</em></h2>
          <p>
            Away from code I enjoy staying active, exploring new places, and
            shaping ideas like my mobile automation app. These interests keep
            me creative, focused and motivated in my work.
          </p>
        </div>
        <div class="beyond-gallery">
          {beyondCards.map((card, index) => (
            <article class="beyond-card" data-reveal style={`--reveal-delay: ${index * 80}ms`}>
              <img src={card.image} alt="" loading="lazy" />
              <div>
                <h3>{card.title}</h3>
                <p>{card.subtitle}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="redesign-section contact-section" id="contact" aria-labelledby="contact-title">
      <div class="section-kicker">04. Get in touch</div>
      <div class="contact-layout">
        <div class="contact-copy" data-reveal>
          <h2 id="contact-title">Let's build <em>something great.</em></h2>
          <p>
            I'm open to new opportunities, freelance work or just a chat about
            interesting ideas.
          </p>
        </div>
        <form class="contact-form" action="https://formspree.io/bov@bovin-desouza.co.uk" method="POST" data-reveal>
          <div>
            <label for="name">Your name</label>
            <input id="name" name="name" type="text" placeholder="Your name" required />
          </div>
          <div>
            <label for="email">Your email</label>
            <input id="email" name="email" type="email" placeholder="Your email" required />
          </div>
          <div class="contact-form__message">
            <label for="message">Your message</label>
            <textarea id="message" name="message" placeholder="Your message" required></textarea>
          </div>
          <button type="submit">Send message &rarr;</button>
        </form>
        <aside class="direct-card" data-reveal>
          <p><span></span> Or connect directly</p>
          <a href="mailto:bovindesouza@gmail.com">bovindesouza@gmail.com</a>
          <a href="https://www.linkedin.com/in/bovin-de-souza-10462b11b/" target="_blank" rel="noreferrer">LinkedIn / bovin-de-souza</a>
          <a href="https://github.com/BD-Git-Hub" target="_blank" rel="noreferrer">GitHub / BD-Git-Hub</a>
          <a class="download-link" href="/BovinDeSouzaCV.pdf" download>Download CV &darr;</a>
        </aside>
      </div>
    </section>
  </main>
  <script src="../scripts/cinematicReveal.ts"></script>
  <script src="../scripts/fiberField.ts"></script>
</BaseLayout>
