---
import BaseLayout from "../layouts/BaseLayout.astro";

const expertise = [
  {
    title: "Web experiences",
    text: "Fast, expressive interfaces that make a brand feel alive while staying clear, usable, and easy to maintain.",
  },
  {
    title: "Commerce and content systems",
    text: "Shopfronts, WordPress builds, Magento ecosystems, and structured content flows built around real customer journeys.",
  },
  {
    title: "Automation and AI tools",
    text: "Practical systems that reduce repetitive work, connect services, and turn product ideas into useful workflows.",
  },
  {
    title: "3D and interactive visuals",
    text: "Immersive details, motion, and WebGL moments that give digital products a more cinematic sense of presence.",
  },
];

const skillGroups = [
  {
    title: "Web skills",
    summary: "Front-end foundations and implementation tools for building clear, reliable interfaces.",
    skills: [
      { name: "HTML5", level: "3+ years" },
      { name: "CSS3", level: "3+ years" },
      { name: "JavaScript", level: "3+ years" },
      { name: "jQuery", level: "3+ years" },
      { name: "PHP", level: "3+ years" },
      { name: "Photoshop", level: "3+ years" },
    ],
  },
  {
    title: "Interpersonal skills",
    summary: "The working habits that keep builds moving, clear, and collaborative.",
    skills: [
      { name: "Time management", level: "Permanent" },
      { name: "Fluent English", level: "Permanent" },
      { name: "High work ethic", level: "Permanent" },
      { name: "Team player", level: "Permanent" },
    ],
  },
  {
    title: "3D skills",
    summary: "Production and interaction skills that support cinematic, visual-first digital work.",
    skills: [
      { name: "Autodesk Maya", level: "3 years" },
      { name: "ZBrush", level: "3 years" },
      { name: "After Effects", level: "2 years" },
      { name: "Substance Painter", level: "2 years" },
      { name: "Unity", level: "1 year" },
    ],
  },
];

const projects = [
  {
    title: "Automate Me",
    image: "/media/images/projectimg/automate-me-placeholder.svg",
    imageAlt: "Automate Me mobile automation concept preview",
    kicker: "Mobile automation concept",
    outcome:
      "An in-progress mobile application concept focused on reducing repetitive tasks and turning everyday automation ideas into a usable product flow.",
    signal: "Mobile / Automation / In build",
  },
  {
    title: "Cut To Size",
    href: "https://cuttosize.co.uk/",
    image: "/media/images/projectimg/Cuttosize.webp",
    imageAlt: "Cut To Size website preview",
    kicker: "Conversion-led trade website",
    outcome:
      "A focused web presence for a precision wood cutting supplier, helping trade customers move quickly from discovery to quote request or price-list download.",
    signal: "AWS hosting / Quote journey / Trade clarity",
  },
  {
    title: "Cut My",
    href: "https://www.cutmy.co.uk/",
    image: "/media/images/projectimg/cutMy.webp",
    imageAlt: "Cut My website preview",
    kicker: "Custom materials commerce",
    outcome:
      "A cut-to-size DIY materials store shaped around a simpler buying path for custom plastic and wood products across a Magento and AWS stack.",
    signal: "Magento / Microservices / Product ordering",
  },
  {
    title: "Echelon Estates",
    href: "https://site4.bovin-desouza-wordpress.com/",
    image: "/media/images/projectimg/EchelonEstates.webp",
    imageAlt: "Echelon Estates website preview",
    kicker: "Luxury property listings",
    outcome:
      "A polished property platform with reusable listing templates, CSV imports, and search-ready content patterns for high-end real estate presentation.",
    signal: "WordPress / ACF / SEO structure",
  },
  {
    title: "Basket & Co",
    href: "https://site3.bovin-desouza-wordpress.com/",
    image: "/media/images/projectimg/basket&Co.webp",
    imageAlt: "Basket & Co ecommerce website preview",
    kicker: "Everyday essentials storefront",
    outcome:
      "A WooCommerce experience with category browsing, cart, checkout, test payments, analytics visibility, and content blocks that support ongoing merchandising.",
    signal: "WooCommerce / Checkout / Analytics",
  },
  {
    title: "FilmFlick",
    href: "https://movies-project-vue-8ql2.vercel.app/home",
    image: "/media/images/projectimg/moviesSiteImg.webp",
    imageAlt: "FilmFlick movie discovery website preview",
    kicker: "Movie discovery product",
    outcome:
      "A responsive Vue app for searching films, filtering by genre, viewing ratings and trailers, and managing watchlist-style interactions from live movie data.",
    signal: "Vue / TMDB API / Responsive UI",
  },
  {
    title: "Macros Calculator",
    href: "https://macro-calculator-website.vercel.app/",
    image: "/media/images/projectimg/macrosCalculatorSiteImg.webp",
    imageAlt: "Macros Calculator website preview",
    kicker: "Personal nutrition tracker",
    outcome:
      "A React tool for logging daily carbs, protein, and fats with account access, saved entries, and automatic logout for safer personal tracking.",
    signal: "React / Firebase / Auth flow",
  },
  {
    title: "Suits and Styles",
    href: "https://site1.bovin-desouza-wordpress.com/",
    image: "/media/images/projectimg/SuitsAndStyles.webp",
    imageAlt: "Suits and Styles WordPress website preview",
    kicker: "Tailoring brand website",
    outcome:
      "A business site for a tailoring brand, designed around service discovery, brand story, and simple enquiry paths for prospective customers.",
    signal: "WordPress / Elementor / Enquiries",
  },
  {
    title: "Taste Travel",
    href: "https://site2.bovin-desouza-wordpress.com/",
    image: "/media/images/projectimg/tasteTravel.webp",
    imageAlt: "Taste Travel WordPress website preview",
    kicker: "Travel content platform",
    outcome:
      "A destination-led travel blog with structured navigation, location pages, newsletter signup, and enquiry routes for ongoing content publishing.",
    signal: "WordPress / Content model / Newsletter",
  },
  {
    title: "3D Portfolio Website",
    image: "/media/images/projectimg/3DsiteImg.webp",
    imageAlt: "3D portfolio website preview",
    kicker: "Interactive 3D showcase",
    outcome:
      "A visual portfolio experiment built to demonstrate 3D production skills and create a more graphical viewing experience for interactive work.",
    signal: "3D visuals / Portfolio concept / Not hosted",
  },
];

const routine = [
  { time: "4:00 AM", label: "Wake up" },
  { time: "6:00 AM", label: "Gym" },
  { time: "9:00 AM", label: "Work" },
  { time: "2:00 PM", label: "Lunch" },
  { time: "5:00 PM", label: "Social" },
  { time: "10:00 PM", label: "Sleep" },
];

const lifePhotos = [
  {
    src: "/media/images/me/me.webp",
    alt: "Bovin scuba diving",
    caption: "Exploration",
  },
  {
    src: "/media/images/me/me2.webp",
    alt: "Bovin graduating",
    caption: "Progress",
  },
  {
    src: "/media/images/me/me3.webp",
    alt: "Bovin at Eastbourne Airbourne",
    caption: "Balance",
  },
];

const process = [
  {
    step: "01",
    title: "Discover",
    text: "Understand the goal, audience, constraints, and the moment where the experience needs to feel effortless.",
  },
  {
    step: "02",
    title: "Shape",
    text: "Turn the idea into a focused direction: visual rhythm, content structure, interaction model, and technical route.",
  },
  {
    step: "03",
    title: "Build",
    text: "Create the interface, systems, and motion details with clean implementation and practical deployment in mind.",
  },
  {
    step: "04",
    title: "Launch",
    text: "Prepare the final static build, test the experience, and ship a site that can keep evolving after release.",
  },
];
---

<BaseLayout>
  <a class="skip-link" href="#work">Skip to selected work</a>
  <main>
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero__bg">
        <div class="hero__fallback" aria-hidden="true">
          <img src="/media/images/coverartimg/lightbluesky.png" alt="" />
          <img src="/media/images/coverartimg/smallmoon.png" alt="" />
          <img src="/media/images/coverartimg/biggermoon.png" alt="" />
          <img src="/media/images/coverartimg/pinkbackgroundcloud.png" alt="" />
          <img src="/media/images/coverartimg/purplebackgroundcloud.png" alt="" />
          <img src="/media/images/coverartimg/blueocean.png" alt="" />
          <img src="/media/images/coverartimg/people.png" alt="" />
          <img src="/media/images/coverartimg/piergrinds.png" alt="" />
          <img src="/media/images/coverartimg/orangesands.png" alt="" />
          <img src="/media/images/coverartimg/darkerorange.png" alt="" />
          <img src="/media/images/coverartimg/big%20birds.png" alt="" />
          <img src="/media/images/coverartimg/medium%20birds.png" alt="" />
          <img src="/media/images/coverartimg/small%20birds.png" alt="" />
          <img src="/media/images/coverartimg/pier.png" alt="" />
        </div>
        <canvas id="particle-hero" class="hero__canvas" aria-hidden="true"></canvas>
        <div class="hero__glow hero__glow--cyan" aria-hidden="true"></div>
        <div class="hero__glow hero__glow--violet" aria-hidden="true"></div>
        <div class="hero__grid" aria-hidden="true"></div>
        <div class="hero__scanline" aria-hidden="true"></div>
      </div>

      <header class="site-header" aria-label="Primary navigation">
        <a class="site-header__brand" href="#top" aria-label="Bovin De Souza home">
          <span>Bovin</span>
          <span>De Souza</span>
        </a>
        <nav class="site-header__nav">
          <a href="#work">Work</a>
          <a href="#expertise">Expertise</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
        </nav>
        <span class="site-header__progress" aria-hidden="true"></span>
      </header>

      <div class="hero__content" data-reveal>
        <p class="eyebrow">Brighton-based developer / personal digital studio</p>
        <h1 id="hero-title">Designing sharp web systems with cinematic digital depth.</h1>
        <p class="hero__intro">
          I am Bovin De Souza, a developer creating premium web experiences,
          automation tools, 3D interactions, and digital products that feel calm,
          useful, and future-facing.
        </p>
        <div class="hero__actions" aria-label="Hero calls to action">
          <a class="button button--primary" href="#work">View selected work</a>
          <a class="button button--ghost" href="#expertise">Explore expertise</a>
        </div>
      </div>

      <aside class="hero__signal" aria-label="Current focus" data-reveal style="--reveal-delay: 180ms">
        <span>Current focus</span>
        <strong>WebGL, AI workflows, commerce systems</strong>
      </aside>

      <a class="hero__scroll" href="#work" aria-label="Scroll to selected work">
        <span>Scroll</span>
      </a>
    </section>

    <section class="section work" id="work" aria-labelledby="work-title">
      <div class="section__label" data-reveal>Selected work</div>
      <div class="section__heading section__heading--split" data-reveal>
        <div>
          <p class="eyebrow">Outcomes over tech lists</p>
          <h2 id="work-title">Projects shaped around business value and user flow.</h2>
        </div>
        <p>
          A stable archive of selected builds, from automation concepts to
          commerce systems and interactive products.
        </p>
      </div>

      <div class="work__track" aria-label="Selected work scroll track">
        {
          projects.map((project, index) => (
            <div class="project-step" style={`--card-index: ${index + 1}`}>
              <article class="project-card">
                {
                  project.href ? (
                    <a class="project-card__media" href={project.href} target="_blank" rel="noreferrer">
                      <img src={project.image} alt={project.imageAlt} loading="lazy" />
                    </a>
                  ) : (
                    <div class="project-card__media project-card__media--static">
                      <img src={project.image} alt={project.imageAlt} loading="lazy" />
                    </div>
                  )
                }
                <div class="project-card__body">
                  <p class="project-card__kicker">{project.kicker}</p>
                  <h3>
                    {
                      project.href ? (
                        <a href={project.href} target="_blank" rel="noreferrer">{project.title}</a>
                      ) : (
                        project.title
                      )
                    }
                  </h3>
                  <p>{project.outcome}</p>
                  <span>{project.signal}</span>
                </div>
              </article>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section expertise" id="expertise" aria-labelledby="expertise-title">
      <div class="section__label" data-reveal>Expertise + Skills</div>
      <div class="section__heading section__heading--split" data-reveal>
        <div>
          <p class="eyebrow">What I build, and what I build with</p>
          <h2 id="expertise-title">Digital systems with craft, clarity, and momentum.</h2>
        </div>
        <p>
          Expertise is the outcome: web experiences, commerce systems,
          automation tools, and interactive visuals. Skills are the practical
          tools that make those outcomes possible.
        </p>
      </div>
      <div class="expertise__grid">
        {
          expertise.map((item, index) => (
            <article class="expertise-card" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
              <span aria-hidden="true"></span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
      <div class="skills__grid expertise__skills" aria-label="Skills toolkit">
        {
          skillGroups.map((group, groupIndex) => (
            <article class="skill-panel" data-reveal style={`--reveal-delay: ${groupIndex * 90}ms`}>
              <div class="skill-panel__header">
                <span>0{groupIndex + 1}</span>
                <h3>{group.title}</h3>
                <p>{group.summary}</p>
              </div>
              <ul class="skill-panel__list" aria-label={group.title}>
                {
                  group.skills.map((skill) => (
                    <li>
                      <span>{skill.name}</span>
                      <strong>{skill.level}</strong>
                    </li>
                  ))
                }
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section intro" id="about" aria-labelledby="about-title">
      <div class="section__label" data-reveal>About</div>
      <div class="intro__copy" data-reveal>
        <h2 id="about-title">A personal portfolio with agency-level polish.</h2>
        <p>
          Bovin De Souza is a Brighton-based developer building websites, product
          interfaces, automation tools, and interactive visual systems. The work
          sits where practical engineering meets atmosphere: clear journeys,
          purposeful movement, and digital products that make people want to keep
          exploring.
        </p>
      </div>
      <div class="intro__stats" aria-label="Practice highlights" data-reveal>
        <div style="--reveal-delay: 80ms">
          <strong>4</strong>
          <span>Core disciplines</span>
        </div>
        <div style="--reveal-delay: 140ms">
          <strong>10</strong>
          <span>Selected builds</span>
        </div>
        <div style="--reveal-delay: 200ms">
          <strong>01</strong>
          <span>Independent studio mindset</span>
        </div>
      </div>
    </section>

    <section class="section life" aria-labelledby="life-title">
      <div class="section__label" data-reveal>Beyond the desk</div>
      <div class="section__heading section__heading--split" data-reveal>
        <div>
          <p class="eyebrow">Structure, balance, and curiosity</p>
          <h2 id="life-title">The rhythm behind the work.</h2>
        </div>
        <p>
          Moving to the UK shaped a long-running interest in connection,
          belonging, and how software can help people move through everyday
          challenges with more clarity.
        </p>
      </div>
      <div class="life__layout">
        <div class="life__routine" data-reveal>
          {
            routine.map((item, index) => (
              <div class="life__routine-step" style={`--reveal-delay: ${index * 55}ms`}>
                <span>{item.time}</span>
                <strong>{item.label}</strong>
              </div>
            ))
          }
        </div>
        <div class="life__photos" data-reveal style="--reveal-delay: 140ms">
          {
            lifePhotos.map((photo) => (
              <figure>
                <img src={photo.src} alt={photo.alt} loading="lazy" />
                <figcaption>{photo.caption}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section process" aria-labelledby="process-title">
      <div class="section__label" data-reveal>Process</div>
      <div class="section__heading" data-reveal>
        <p class="eyebrow">How ideas become shipped work</p>
        <h2 id="process-title">A simple path from first signal to live product.</h2>
      </div>
      <div class="process__timeline">
        {
          process.map((item, index) => (
            <article class="process-step" data-reveal style={`--reveal-delay: ${index * 85}ms`}>
              <span>{item.step}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title" data-reveal>
      <div class="contact__orb" aria-hidden="true"></div>
      <p class="eyebrow">Contact</p>
      <h2 id="contact-title">Have a build, product idea, or automation problem worth shaping?</h2>
      <a class="contact__email" href="mailto:bovindesouza@gmail.com">bovindesouza@gmail.com</a>
    </section>
  </main>

  <script src="../scripts/particleHero.ts"></script>
  <script src="../scripts/cinematicReveal.ts"></script>
</BaseLayout>
